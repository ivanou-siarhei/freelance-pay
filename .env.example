# ── Backend ──
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/payflow?sslmode=require
# Случайная строка >= 32 символов: openssl rand -hex 32
SESSION_SECRET=
ALLOWED_ORIGINS=http://localhost:3000
ARC_RPC_URL=https://rpc.testnet.arc.io
PORT=3001

# ── Frontend (Vite, попадает в браузер: никаких секретов!) ──
VITE_ESCROW_ADDRESS=0x...
# Необязательно: адрес для комиссии платформы при бридже. Пусто = без комиссии.
VITE_FEE_RECIPIENT=
VITE_FEE_BPS=0
